# Ambiente
NODE_ENV=development
PORT=3000

# Banco PostgreSQL/ Railway
DATABASE_URL=postgresql://usuario:senha@host:5432/abiatar
TYPEORM_SYNCHRONIZE=false

# Autenticação — gere um valor aleatório forte, nunca versionado
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# JSON da conta de serviço do Firebase Admin; nunca versionar a credencial real
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"seu-projeto"}
